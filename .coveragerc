[run]
source = .
omit =
    test_*.py
    conftest.py
    ci_mocks.py
    setup_interactive.py
    */site-packages/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov
